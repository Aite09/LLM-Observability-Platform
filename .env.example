# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=llmobs
POSTGRES_PASSWORD=llmobs_secret
POSTGRES_DB=llm_observability

# asyncpg format — note postgresql+asyncpg:// prefix
DATABASE_URL=postgresql+asyncpg://llmobs:llmobs_secret@localhost:5432/llm_observability

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Eval Gate ─────────────────────────────────────────────────────────────────
# Deploy blocks if pass_rate < this value
EVAL_GATE_THRESHOLD=0.8

# ── Drift Detection ───────────────────────────────────────────────────────────
# Optional — leave blank to disable webhooks
DRIFT_WEBHOOK_URL=

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_NAME=llm-observability
