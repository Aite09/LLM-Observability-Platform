# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=llmobs
POSTGRES_PASSWORD=llmobs_secret
POSTGRES_DB=llm_observability

# asyncpg format — note postgresql+asyncpg:// prefix
DATABASE_URL=postgresql+asyncpg://llmobs:llmobs_secret@localhost:5432/llm_observability

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# LLM judge: mock (free, default) or anthropic (needs key, costs pennies/run)
JUDGE_PROVIDER=mock
JUDGE_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=

# Local embeddings (fastembed, free)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Worker intervals (seconds)
METRICS_INTERVAL_SECONDS=300
DRIFT_CHECK_INTERVAL_SECONDS=3600

# Drift detection windows
DRIFT_BASELINE_DAYS=7
DRIFT_MIN_BASELINE=50
DRIFT_MIN_CURRENT=20

# HMAC secret for signing drift webhooks
WEBHOOK_SECRET=change-me

# OTEL OTLP endpoint (empty = tracing no-op)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Eval Gate ─────────────────────────────────────────────────────────────────
# Deploy blocks if pass_rate < this value
EVAL_GATE_THRESHOLD=0.8

# ── Drift Detection ───────────────────────────────────────────────────────────
# Optional — leave blank to disable webhooks
DRIFT_WEBHOOK_URL=

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_NAME=llm-observability
